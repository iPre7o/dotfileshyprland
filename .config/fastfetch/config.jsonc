{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "color": {
            "1": "white",
            "2": "white"
        },
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "white"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "white",
                "at": "white",
                "host": "white"
            }
        },
        "separator",
        { "type": "os", "key": "󰌽 OS" },
        { "type": "kernel", "key": "󰘚 Kernel" },
        { "type": "uptime", "key": "󰅐 Uptime" },
        { "type": "packages", "key": "󰏖 Pacotes" },
        { "type": "shell", "key": "󰞷 Shell" },
        { "type": "terminal", "key": "󰆍 Terminal" },
        "break",
        { "type": "cpu", "key": "󰻠 CPU" },
        { "type": "gpu", "key": "󰢮 GPU", "hideType": "integrated" },
        { "type": "memory", "key": "󰍛 RAM" },
        { "type": "disk", "key": "󰋊 Disco" },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
