{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 2,

  "modules-left": ["custom/ws-1", "custom/ws-2", "custom/ws-3", "custom/ws-4", "custom/ws-5", "custom/ws-6", "custom/ws-7", "custom/ws-8", "custom/ws-9", "custom/ws-10", "custom/active-app"],
  "modules-center": ["custom/clock"],
  "modules-right": ["custom/net-speed", "custom/claude", "custom/clipboard"],

  "custom/ws-1": { "exec": "~/.config/waybar/scripts/ws-button.sh 1", "return-type": "json", "interval": "once", "signal": 11, "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 1 })\"" },
  "custom/ws-2": { "exec": "~/.config/waybar/scripts/ws-button.sh 2", "return-type": "json", "interval": "once", "signal": 11, "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 2 })\"" },
  "custom/ws-3": { "exec": "~/.config/waybar/scripts/ws-button.sh 3", "return-type": "json", "interval": "once", "signal": 11, "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 3 })\"" },
  "custom/ws-4": { "exec": "~/.config/waybar/scripts/ws-button.sh 4", "return-type": "json", "interval": "once", "signal": 11, "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 4 })\"" },
  "custom/ws-5": { "exec": "~/.config/waybar/scripts/ws-button.sh 5", "return-type": "json", "interval": "once", "signal": 11, "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 5 })\"" },
  "custom/ws-6": { "exec": "~/.config/waybar/scripts/ws-button.sh 6", "return-type": "json", "interval": "once", "signal": 11, "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 6 })\"" },
  "custom/ws-7": { "exec": "~/.config/waybar/scripts/ws-button.sh 7", "return-type": "json", "interval": "once", "signal": 11, "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 7 })\"" },
  "custom/ws-8": { "exec": "~/.config/waybar/scripts/ws-button.sh 8", "return-type": "json", "interval": "once", "signal": 11, "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 8 })\"" },
  "custom/ws-9": { "exec": "~/.config/waybar/scripts/ws-button.sh 9", "return-type": "json", "interval": "once", "signal": 11, "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 9 })\"" },
  "custom/ws-10": { "exec": "~/.config/waybar/scripts/ws-button.sh 10", "return-type": "json", "interval": "once", "signal": 11, "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = 10 })\"" },

  "custom/claude": { "exec": "~/.config/waybar/scripts/claude-notify.sh", "return-type": "json", "interval": 30, "signal": 12, "on-click": "~/.config/waybar/scripts/claude-notify.sh click" },

  "custom/net-speed": { "exec": "~/.config/waybar/scripts/net-speed.py", "return-type": "json", "escape": true },

  "custom/active-app": { "exec": "~/.config/waybar/scripts/active-app.py", "return-type": "json", "max-length": 40 },

  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock-focus.py",
    "return-type": "json",
    "on-click": "sh -c 'kill -USR1 $(cat $XDG_RUNTIME_DIR/welcome-desk.pid)'",
    "on-click-right": "gsimplecal"
  },

  "custom/clipboard": {
    "format": "󰅌",
    "tooltip-format": "Área de transferência (SUPER+V)",
    "on-click": "~/.config/waybar/scripts/clipboard-menu.sh bar"
  }
}
